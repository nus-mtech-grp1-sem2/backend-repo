{
  "openapi": "3.0.3",
  "info": {
    "title": "OneStage internal Authorization API",
    "version": "1.0.0",
    "description": "Internal additive foundation; no public Kong route. No positive decision caching. Domain chooses action and enforces resource invariants."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3008",
      "description": "Local testing only; protected transport required for remote deployment"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "authorizationHealth",
        "summary": "Process liveness (not database readiness)",
        "responses": {
          "200": {
            "description": "Process is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "authorization"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/authorize": {
      "post": {
        "operationId": "authorizeAction",
        "summary": "Evaluate a caller action against event assignments",
        "description": "Both workload credential and original Cognito access token required. Unknown actions denied as invalid requests. No caller identity fields accepted. Stateless evaluation; retries do not mutate data. Owner restrictions use migrated owner assignments.",
        "security": [
          {
            "workloadToken": [],
            "cognitoAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "action"
                    ],
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "event.create"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "action",
                      "eventId"
                    ],
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "event.update",
                          "event.publish",
                          "event.cancel",
                          "event.delete",
                          "event.team.read",
                          "event.team.invite",
                          "event.team.revoke",
                          "event.team.revoke-organizer",
                          "ticket.search",
                          "ticket.checkin",
                          "ticket.stats.read"
                        ]
                      },
                      "eventId": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                ]
              },
              "example": {
                "action": "ticket.checkin",
                "eventId": 101
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Allowed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "allowed",
                    "decisionId",
                    "policyVersion"
                  ],
                  "properties": {
                    "allowed": {
                      "type": "boolean"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "policyVersion": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or unknown action",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid workload credential or caller access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Explicit policy denial",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "allowed",
                    "decisionId",
                    "policyVersion"
                  ],
                  "properties": {
                    "allowed": {
                      "type": "boolean"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "policyVersion": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal request failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Authorization storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "workloadToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      },
      "cognitoAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Cognito access JWT"
      }
    }
  }
}
