{
  "name": "backend-repo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "docker compose -f infrastructure/docker-compose.yml --env-file .env up --build",
    "down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down",
    "logs": "docker compose -f infrastructure/docker-compose.yml --env-file .env logs -f",
    "db:aws-ip": "powershell -ExecutionPolicy Bypass -File scripts/mysql-public-ip.ps1",
    "dev:local": "cross-env HOST=0.0.0.0 concurrently -k -n event,inven,queue,order,ticket,notif,auth -c cyan,magenta,yellow,green,blue,red,white \"npm run dev -w services/event\" \"npm run dev -w services/inventory\" \"npm run dev -w services/queue\" \"npm run dev -w services/order\" \"npm run dev -w services/ticket\" \"npm run dev -w services/notification\" \"npm run dev -w services/auth\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nus-mtech-grp1-sem2/backend-repo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nus-mtech-grp1-sem2/backend-repo/issues"
  },
  "homepage": "https://github.com/nus-mtech-grp1-sem2/backend-repo#readme",
  "description": "",
  "workspaces": [
    "services/event",
    "services/inventory",
    "services/queue",
    "services/order",
    "services/ticket",
    "services/notification",
    "services/auth"
  ],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.3"
  }
}
