# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Terraform artifacts must never be committed
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
.terraform/
# .terraform.lock.hcl IS committed (pins provider versions)

# Local Docker overrides (docker-compose.yml itself IS committed)
docker-compose.override.yml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# Caches
.npm/
.cache/
.eslintcache

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
