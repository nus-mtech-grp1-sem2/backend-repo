# Copy to `.env` in this folder and fill in. `.env` is gitignored — never commit it.
# Docker Compose reads this file automatically because it sits next to
# docker-compose.yml.

# --- Which Cognito user pool to verify tokens against (not secrets) ---
COGNITO_USER_POOL_ID=ap-southeast-1_cgmx4fpO2
COGNITO_CLIENT_ID=gh94lqsterju3qoffje1grep8

# --- Credentials for the admin calls that grant group membership ---
# Local development only. In AWS these stay empty and the ECS task role supplies
# credentials automatically.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Local Docker can read an existing AWS CLI profile from this directory.
# Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY empty when using this option.
AWS_SHARED_CONFIG_DIR=
AWS_PROFILE=default

# Optional locally. Terraform supplies this automatically to the Queue Service in AWS.
CUSTOMER_ADMITTED_QUEUE_URL=

# Optional locally. Empty uses a seven-second synchronous mock-payment fallback.
# Set only to a dedicated payment queue, NEVER the OrderPaid/ticket queue.
PAYMENT_REQUESTS_QUEUE_URL=

# Queue Service background admission worker.
AUTO_ADMISSION_ENABLED=true
ADMISSION_SCHEDULER_POLL_MS=1000
