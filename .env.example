# Database Configuration - AWS RDS MySQL
# Copy this file to .env and fill in your actual values

# Local dev default: DB_HOST=mysql (the docker-compose mysql container).
# To test against the shared AWS database instead: run `npm run db:aws-ip` for
# the current Fargate task IP, and get the real DB_USER/DB_PASSWORD from a
# teammate (AWS Secrets Manager values) — never commit real AWS credentials here.
DB_HOST=mysql

# Database Port (default MySQL port)
DB_PORT=3306

# Database Name
DB_NAME=your_database_name
DB_NAME_TICKETING=ticketing

# Service-owned database schemas
DB_NAME_EVENT_INVENTORY=event_inventory
DB_NAME_QUEUE=queue
DB_NAME_CHECKOUT=checkout
DB_NAME_TICKETING=ticketing
DB_NAME_NOTIFICATION=notification

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# MySQL root password for the local docker-compose mysql container (local dev only)
MYSQL_ROOT_PASSWORD=your_root_password

# Connection Pool Settings (optional but recommended)
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# SSL/TLS Configuration (recommended for RDS)
DB_SSL=true

# Ticket service signing and internal integration secrets. Generate locally;
# never commit real values.
SCANNER_SESSION_SECRET=replace_with_a_local_random_secret
TICKET_INTERNAL_SHARED_SECRET=replace_with_a_local_random_secret

# Additional MySQL Options (optional)
DB_TIMEZONE=UTC
DB_CHARSET=utf8mb4

# Node Environment
NODE_ENV=development

# Gmail SMTP sender for the notification service's booking confirmation email.
# SMTP_APP_PASSWORD is a Gmail App Password (not the account password) —
# generate one at https://myaccount.google.com/apppasswords for the
# onestagecontacts@gmail.com account. Never commit the real value.
SMTP_USER=onestagecontacts@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
