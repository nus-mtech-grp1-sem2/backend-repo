# Database Configuration - AWS RDS MySQL
# Copy this file to .env and fill in your actual values

# Local dev default: DB_HOST=mysql (the docker-compose mysql container).
# To test against the shared AWS database instead: run `npm run db:aws-ip` for
# the current Fargate task IP, and get the real DB_USER/DB_PASSWORD from a
# teammate (AWS Secrets Manager values) — never commit real AWS credentials here.
DB_HOST=mysql

# Database Port (default MySQL port)
DB_PORT=3306

# Database Name
DB_NAME=your_database_name

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# MySQL root password for the local docker-compose mysql container (local dev only)
MYSQL_ROOT_PASSWORD=your_root_password

# Connection Pool Settings (optional but recommended)
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# SSL/TLS Configuration (recommended for RDS)
DB_SSL=true

# Additional MySQL Options (optional)
DB_TIMEZONE=UTC
DB_CHARSET=utf8mb4

# Node Environment
NODE_ENV=development
