# Database Configuration - AWS RDS MySQL
# Copy this file to .env and fill in your actual values

# RDS MySQL Host (endpoint)
DB_HOST=your-rds-instance.xxxxxxxxxxxx.region.rds.amazonaws.com

# Database Port (default MySQL port)
DB_PORT=3306

# Database Name
DB_NAME=your_database_name

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# Connection Pool Settings (optional but recommended)
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# SSL/TLS Configuration (recommended for RDS)
DB_SSL=true

# Additional MySQL Options (optional)
DB_TIMEZONE=UTC
DB_CHARSET=utf8mb4

# Node Environment
NODE_ENV=development
