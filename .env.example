# Database Configuration - AWS RDS MySQL
# Copy this file to .env and fill in your actual values

# Local dev default: DB_HOST=mysql (the docker-compose mysql container).
# To test against the shared AWS database instead: run `npm run db:aws-ip` for
# the current Fargate task IP, and get the real DB_USER/DB_PASSWORD from a
# teammate (AWS Secrets Manager values) — never commit real AWS credentials here.
DB_HOST=mysql

# Database Port (default MySQL port)
DB_PORT=3306

# Database Name
DB_NAME=your_database_name

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# MySQL root password for the local docker-compose mysql container (local dev only)
MYSQL_ROOT_PASSWORD=your_root_password

# Connection Pool Settings (optional but recommended)
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# SSL/TLS Configuration (recommended for RDS)
DB_SSL=true

# Additional MySQL Options (optional)
DB_TIMEZONE=UTC
DB_CHARSET=utf8mb4

# Node Environment
NODE_ENV=development

# Cognito JWT validation used by protected service endpoints
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_app_client_id

# Queue admission. Generate a strong random value and keep it out of source control.
INTERNAL_API_TOKEN=your_internal_scheduler_token
ADMISSION_TOKEN_TTL_SEC=600
AUTO_ADMISSION_ENABLED=true
ADMISSION_SCHEDULER_POLL_MS=1000

# Optional locally; required in AWS for asynchronous ticket issuance.
ORDER_EVENTS_QUEUE_URL=
# Optional locally; required in AWS to notify consumers after queue admission.
CUSTOMER_ADMITTED_QUEUE_URL=
AWS_REGION=ap-southeast-1
# Local Docker mounts this AWS CLI profile read-only for the SQS services.
# Override AWS_SHARED_CONFIG_DIR only if your profile is not in ~/.aws.
AWS_SHARED_CONFIG_DIR=
AWS_PROFILE=default
